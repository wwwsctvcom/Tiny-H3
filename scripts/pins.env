# Pinned revisions.  Sourced by scripts/setup_env.sh and documented in README.

# MiniMax-H3 lives on diffusers `main` (0.41.0.dev0), first included after the 0.40.0
# release; the tip used while building Tiny-H3 is pinned here.
DIFFUSERS_COMMIT=a71e62e0d226c284b86abf518791a5ffbba064bf
DIFFUSERS_REPO=https://github.com/huggingface/diffusers.git

# Reference implementation for the RL half (Flow-GRPO loss, SDE step with log-prob).
MILES_DIFFUSION_COMMIT=1aabbf0d591fe58f613b581d571db2b99324d07b
MILES_DIFFUSION_REPO=https://github.com/radixark/miles_diffusion.git

# Only used by `setup_env.sh --with-torch` on a bare Python env.  RTX 5090 is sm_120 and
# needs a CUDA 12.8+ build; the AutoDL image already ships a matching torch.
TORCH_VERSION=2.12.1

# Official assets.  The DiT (66 GB) and Qwen3-VL text encoder (66 GB) are deliberately not
# downloaded -- Tiny-H3 trains its own tiny DiT and conditions on t5-small.
H3_REPO=MiniMaxAI/MiniMax-H3
H3_VIDEO_VAE_SUBFOLDER=vae
H3_AUDIO_VAE_SUBFOLDER=audio_vae

# Real training data (optional; the default dataset is generated procedurally).
WISA_DATASET=rockdu/WISA-80K-Practical-Dynamics-254
CONCERTS_DATASET=alejandroparedeslatorre/concerts_audiovideo_dataset
